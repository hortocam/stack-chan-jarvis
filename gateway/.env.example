# Jarvis Device Gateway — every JG_* key from the plan's Configuration Reference.
#
# Copy to /etc/jarvis-gateway/env (mode 0600) on CT 914 and edit the two secrets.
# The values below are non-secret placeholders; load_config() rejects an empty
# JG_DEVICE_TOKEN or JG_HERMES_API_KEY, so a copy of this file always parses.

# The only inbound listener (VLAN 20 -> :8010).
JG_BIND_HOST=0.0.0.0
JG_BIND_PORT=8010
JG_PUBLIC_BASE_URL=http://172.16.90.14:8010
JG_WS_PATH=/xiaozhi/v1/
JG_OTA_PATH=/xiaozhi/ota/

# Shared bearer token for the OTA/WebSocket handshake. Rotate here only.
JG_DEVICE_TOKEN=change-me-shared-device-token
JG_FIRMWARE_VERSION=1.0.0

# Existing whisper on CT 912 — consumed as-is.
JG_STT_URL=http://172.16.90.12:8001
JG_STT_TIMEOUT_S=10

# Hermes brain — loopback only, never the LAN address.
JG_HERMES_BASE_URL=http://127.0.0.1:8642/v1
JG_HERMES_API_KEY=change-me-hermes-api-key
JG_HERMES_MODEL=hermes-agent
JG_HERMES_TIMEOUT_S=30

# edge-tts, pinned voice; no account.
JG_VOICE=en-GB-RyanNeural
JG_TTS_TIMEOUT_S=15

# Voice activity detection and session lifetime.
JG_VAD_SILENCE_MS=300
JG_VAD_MIN_SPEECH_MS=250
JG_MAX_UTTERANCE_S=30
JG_SESSION_IDLE_S=120

# Control socket for the Hermes-launched MCP bridge (UNIX, never TCP).
JG_CONTROL_SOCKET=/run/jarvis-gateway/control.sock

# Privacy default: transcripts stay out of the logs (FR-016).
JG_LOG_TRANSCRIPTS=false
JG_APOLOGY_TEXT=Sorry, I didn't catch that.
